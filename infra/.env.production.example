# AgentNet production environment template.
# Copy this file to infra/.env.production and replace every CHANGE_ME value.
# Never commit infra/.env.production.

AGENTNET_ENV=production
LOG_LEVEL=INFO

# Public URL used by documentation, callbacks, and future generated links.
PUBLIC_BASE_URL=https://example.com

# API runtime limits.
MAX_PAYLOAD_BYTES=1048576
WS_HEARTBEAT_INTERVAL_S=15
WS_HEARTBEAT_TIMEOUT_S=45
WS_MAX_CONNECTIONS_PER_AGENT=3

# Rate limiting.
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_AGENT_MAX=200
RATE_LIMIT_IP_MAX=100

# Task leases and timeout worker.
TASK_MAX_RUNTIME_S=600
TASK_LEASE_DURATION_S=60
TIMEOUT_WORKER_INTERVAL_S=30

# PostgreSQL.
POSTGRES_DB=agentnet
POSTGRES_USER=agentnet
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Redis.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# These URLs are documented for operators. docker-compose.prod.yml computes
# the same values from POSTGRES_* and REDIS_PASSWORD to avoid drift.
DATABASE_URL=postgresql+asyncpg://agentnet:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/agentnet
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0

# Grafana. Keep Grafana bound to localhost unless you add authentication and TLS.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

