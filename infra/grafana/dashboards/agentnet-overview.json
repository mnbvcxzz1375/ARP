  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "targets": [{ "expr": "sum(rate(agentnet_http_requests_total[5m]))", "legendFormat": "requests/s" }],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(agentnet_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }],
      "title": "API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "targets": [{ "expr": "sum(rate(agentnet_http_errors_total[5m]))", "legendFormat": "5xx/s" }],
      "title": "API 5xx error rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "id": 4,
      "targets": [{ "expr": "agentnet_ws_connections_active", "legendFormat": "active" }],
      "title": "Active WebSocket connections",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "id": 5,
      "targets": [
        { "expr": "agentnet_tasks_created_total", "legendFormat": "created" },
        { "expr": "agentnet_tasks_completed_total", "legendFormat": "completed" },
        { "expr": "agentnet_tasks_failed_total", "legendFormat": "failed" },
        { "expr": "agentnet_tasks_expired_total", "legendFormat": "expired" }
      ],
      "title": "Task status counters",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 6,
      "targets": [{ "expr": "agentnet_pending_messages", "legendFormat": "pending" }],
      "title": "Pending messages",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 7,
      "targets": [{ "expr": "agentnet_approvals_pending", "legendFormat": "pending" }],
      "title": "Pending approvals",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 8,
      "targets": [
        { "expr": "increase(agentnet_messages_retried_total[15m])", "legendFormat": "retries" },
        { "expr": "sum(increase(agentnet_worker_errors_total[15m]))", "legendFormat": "worker errors" }
