{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentnet.dev/schemas/agent.schema.json",
  "title": "Agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "agent_number", "owner_user_id", "name", "runtime", "status"],
  "properties": {
    "id": { "type": "string" },
    "agent_number": { "type": "string", "pattern": "^AN-[A-Z0-9]+-[A-Z0-9]+-[0-9]{2}$" },
    "owner_user_id": { "type": "string" },
    "name": { "type": "string" },
    "runtime": { "type": "string" },
    "description": { "type": ["string", "null"] },
    "visibility": { "type": "string", "default": "private" },
    "discoverable": { "type": "boolean", "default": false },
    "inbound_policy": { "enum": ["private", "contacts_only", "request_approval", "public"] },
    "status": { "enum": ["offline", "online"] },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "security_modes_supported": {
      "type": "array",
      "items": { "enum": ["relay_visible", "relay_encrypted", "e2ee"] }
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

